# Backend Environment Variables

# Flask Configuration
FLASK_ENV="development" # "production" or "development"
PORT=5001 # Port for the backend server

# JWT Configuration
JWT_SECRET_KEY="your-strong-secret-key-here" # Change this in production!

# Database Configuration (Example for PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database_name"

# WhatsApp Integration (Meta API)
WHATSAPP_API_KEY="your_whatsapp_api_key"
WHATSAPP_PHONE_ID="your_whatsapp_phone_number_id"
WHATSAPP_WEBHOOK_SECRET="your_whatsapp_webhook_verification_token"

# Optional: Add other external service keys or configurations here
# EXAMPLE_API_KEY="your_example_api_key"

